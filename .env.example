# Local backend (default when NODE_ENV !== production)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/ws

# Production / Vercel — set these in the Vercel project Environment Variables
# (`.env*` files are gitignored and will NOT deploy automatically)
# NEXT_PUBLIC_API_URL=https://kaku-craft-backend.onrender.com/api
# NEXT_PUBLIC_WS_URL=wss://kaku-craft-backend.onrender.com/ws
